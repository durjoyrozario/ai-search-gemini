# Copy this file to ".env" and fill in your key. Never commit ".env".
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model used to write answers. If it stops working, pick a current Flash model
# from https://ai.google.dev/gemini-api/docs/models
MODEL=gemini-2.5-flash

# Maximum length of one answer (tokens)
MAX_TOKENS=4096

# Requests allowed per IP per minute. 0 = unlimited (default).
# The free tier has its own limits from Google, so a small number like 5 is sensible.
RATE_LIMIT_PER_MIN=5

# Which site may call this backend. "*" = any (needed for an app's local index.html).
# For a GitHub Pages site use its exact address, e.g. https://yourname.github.io
ALLOWED_ORIGIN=*

PORT=3000
